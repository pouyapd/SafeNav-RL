# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/

# Virtual environments
venv/
.venv/
/.env/

# Training outputs (selected results are copied to results/)
runs/
checkpoints/
logs/
*.pt
*.pth
# ...except the ten checkpoints used for the published tables. A directory
# excluded by a pattern cannot have files re-included, so the directory itself
# is re-included first.
!results/checkpoints/
!results/checkpoints/*/
!results/checkpoints/*/seed_*.pt
# ...and the round-2 training checkpoints (best.pt / final.pt per run) needed to reproduce
# the E1a and E4 evaluations.
!research/experiments/e1a/checkpoints/
!research/experiments/e1a/checkpoints/*/
!research/experiments/e1a/checkpoints/*/*/
!research/experiments/e1a/checkpoints/*/*/*.pt
!research/experiments/round2/checkpoints/
!research/experiments/round2/checkpoints/*/
!research/experiments/round2/checkpoints/*/*/
!research/experiments/round2/checkpoints/*/*/*.pt

# Plots and animations
*.gif
*.mp4
/episode.png

